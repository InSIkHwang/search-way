# Reference only: .env is not loaded automatically.
# Pass these values through your MCP client's env settings or your shell.
SEARCH_WAY_ALLOW_LIVE_NETWORK=1
SEARCH_WAY_NAVER_HEADLESS=1
# Optional override; the CLI otherwise uses the user's application-data folder.
# SEARCH_WAY_DATA_DIR=./data/jobs
SEARCH_WAY_PROVIDER_CONCURRENCY=6
SEARCH_WAY_MIN_DELAY_MS=100
SEARCH_WAY_MAX_DELAY_MS=300
SEARCH_WAY_MAX_RETRIES=3
SEARCH_WAY_RETRY_BASE_DELAY_MS=1000
SEARCH_WAY_REQUEST_TIMEOUT_MS=30000
# Defaults to SEARCH_WAY_REQUEST_TIMEOUT_MS + 15000 when omitted.
# SEARCH_WAY_TASK_DEADLINE_MS=45000
SEARCH_WAY_TASK_KILL_GRACE_MS=10000
SEARCH_WAY_STALL_TIMEOUT_MS=600000
