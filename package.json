{
  "name": "search-way",
  "version": "1.0.0",
  "description": "Flexible round-trip flight search MCP server for Google Flights and Naver Flights",
  "main": "dist/mcp/server.js",
  "bin": {
    "search-way": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InSIkHwang/search-way.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/domain tests/orchestrator tests/jobs",
    "test:providers": "vitest run tests/providers",
    "test:mcp": "vitest run tests/mcp",
    "spike:google": "tsx scripts/spike-google.ts",
    "spike:naver": "tsx scripts/spike-naver.ts",
    "start:mcp": "node dist/mcp/server.js",
    "dev:mcp": "tsx src/mcp/server.ts"
  },
  "keywords": ["mcp", "flights", "google-flights", "naver-flights"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "1.61.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
